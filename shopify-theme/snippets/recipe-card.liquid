<article class="article-card"><a href="{{ recipe.system.url }}">{% render 'image', image: recipe.image.value, width: 900, sizes: '(min-width: 750px) 33vw, 100vw', alt: recipe.title.value %}</a><div class="card-body"><p class="eyebrow">{{ recipe.category.value | escape }}</p><h3><a href="{{ recipe.system.url }}">{{ recipe.title.value | escape }}</a></h3><p>{{ recipe.difficulty.value | escape }}{% if recipe.prep_time.value %} · {{ 'recipe.prep' | t }}: {{ recipe.prep_time.value }} {{ 'recipe.minutes' | t }}{% endif %}</p></div></article>
