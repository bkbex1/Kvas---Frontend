<a class="collection-card" href="{{ collection.url }}">{% assign cover = collection.image | default: collection.products.first.featured_image %}{% render 'image', image: cover, sizes: '(min-width: 750px) 50vw, 100vw', alt: collection.title %}<div class="collection-copy"><p>{{ 'collection.count' | t: count: collection.all_products_count }}</p><h3>{{ collection.title | escape }}</h3><span>{{ 'general.view_all' | t }} →</span></div></a>
