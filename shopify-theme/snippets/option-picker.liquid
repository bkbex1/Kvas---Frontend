{% unless product.has_only_default_variant %}
{% for option in product.options_with_values %}
 <fieldset class="option-group"><legend>{{ option.name | escape }}</legend><div class="option-values">
 {% assign option_index = forloop.index %}
 {% for value in option.values %}
  {% capture selected_ids %}{% for other_option in product.options_with_values %}{% if forloop.index == option_index %}{{ value.id }}{% else %}{% for other_value in other_option.values %}{% if other_value.selected %}{{ other_value.id }}{% endif %}{% endfor %}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}
  <a href="{{ value.product_url | default: product.url }}?option_values={{ selected_ids | strip }}" {% if value.selected %}aria-current="true"{% endif %}{% unless value.available %} class="unavailable"{% endunless %}>{{ value.name | escape }}</a>
 {% endfor %}
 </div></fieldset>
{% endfor %}
{% endunless %}
