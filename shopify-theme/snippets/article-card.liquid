<article class="article-card"><a href="{{ article.url }}" tabindex="-1" aria-hidden="true">{% render 'image', image: article.image, width: 900, sizes: '(min-width: 750px) 33vw, 100vw', alt: article.title %}</a><div class="card-body"><p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p><h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p><a class="text-link" href="{{ article.url }}">{{ 'blog.read' | t }} →</a></div></article>
