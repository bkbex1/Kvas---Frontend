<form action="{{ collection.url }}" method="get" class="filters">
<label for="Sort-{{ section.id }}">{{ 'collection.sort' | t }}</label>
<select id="Sort-{{ section.id }}" name="sort_by">{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>
{% for filter in collection.filters %}<details {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label | escape }}</summary>
{% case filter.type %}
{% when 'boolean', 'list' %}<ul>{% for value in filter.values %}<li><label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label></li>{% endfor %}</ul>
{% when 'price_range' %}<div class="filter-price"><label for="Min-{{ section.id }}">{{ 'collection.min_price' | t }} ({{ cart.currency.iso_code }})</label><input id="Min-{{ section.id }}" type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}><label for="Max-{{ section.id }}">{{ 'collection.max_price' | t }} ({{ cart.currency.iso_code }})</label><input id="Max-{{ section.id }}" type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></div>
{% endcase %}</details>{% endfor %}
<button class="button" type="submit">{{ 'collection.apply' | t }}</button><p><a class="text-link" href="{{ collection.url }}">{{ 'collection.clear' | t }}</a></p>
</form>
