{% layout 'theme' %}<div class="container narrow page-space center"><h1>{{ 'gift_card.title' | t }}</h1><p>{{ gift_card.initial_value | money_with_currency }}</p>{% if gift_card.enabled %}<p>{{ 'gift_card.balance' | t }}: {{ gift_card.balance | money_with_currency }}</p><div class="gift-card-code">{{ gift_card.code | format_code }}</div>{% if gift_card.expired %}<p>{{ 'gift_card.expired' | t }}</p>{% endif %}{% else %}<p>{{ 'gift_card.disabled' | t }}</p>{% endif %}<a class="button" href="{{ routes.root_url }}">{{ 'general.shop' | t }}</a></div>
