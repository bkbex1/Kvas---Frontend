<div class="benefits dark"><div class="container grid grid-four">{% for block in section.blocks %}<div class="benefit" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p></div></div>{% endfor %}</div></div>
{% schema %}
{
  "name": "Предимства",
  "tag": "section",
  "class": "kv-section",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Предимство",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Икона",
          "options": [
            {
              "value": "bread",
              "label": "Хляб"
            },
            {
              "value": "truck",
              "label": "Доставка"
            },
            {
              "value": "leaf",
              "label": "Лист"
            },
            {
              "value": "heart",
              "label": "Сърце"
            },
            {
              "value": "search",
              "label": "Търсене"
            },
            {
              "value": "cart",
              "label": "Кошница"
            }
          ],
          "default": "bread"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Заглавие"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Описание"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Предимства"
    }
  ]
}
{% endschema %}
