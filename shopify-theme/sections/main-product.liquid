{% assign selected_variant = product.selected_or_first_available_variant %}
<div class="container page-space"><div class="product-layout">
 <div class="product-gallery">
 {% assign primary_media = selected_variant.featured_media | default: product.featured_media %}
 {% if primary_media %}<div>{% render 'product-media', media: primary_media, loading: 'eager' %}</div>{% endif %}
 {% for media in product.media %}{% unless media.id == primary_media.id %}<div>{% render 'product-media', media: media, loading: 'lazy' %}</div>{% endunless %}{% else %}<div>{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>{% endfor %}
 </div>
 <div class="product-info"><p class="eyebrow">{{ product.type | escape }}</p><h1>{{ product.title | escape }}</h1>
 {% if section.settings.show_vendor %}<p class="small">{{ product.vendor | escape }}</p>{% endif %}
 {% if selected_variant %}{% render 'price', product: product, variant: selected_variant %}{% endif %}
 <p class="stock">{% if selected_variant.available %}{{ 'product.available' | t }}{% elsif selected_variant %}{{ 'product.sold_out' | t }}{% else %}{{ 'product.unavailable' | t }}{% endif %}</p>
 {% if section.settings.show_sku and selected_variant.sku != blank %}<p class="sku">{{ 'product.sku' | t }}: {{ selected_variant.sku | escape }}</p>{% endif %}
 {% render 'option-picker', product: product %}
 {% assign product_form_id = 'ProductForm-' | append: section.id %}
 {% form 'product', product, id: product_form_id, class: 'product-form' %}
  {{ form.errors | default_errors }}
  <input type="hidden" name="id" value="{{ selected_variant.id }}" {% unless selected_variant.available %}disabled{% endunless %}>
  {% if product.selling_plan_groups.size > 0 %}<label for="Plan-{{ section.id }}">{{ 'product.purchase_option' | t }}</label><select id="Plan-{{ section.id }}" name="selling_plan">{% unless product.requires_selling_plan %}<option value="">{{ 'product.one_time' | t }}</option>{% endunless %}{% for allocation in selected_variant.selling_plan_allocations %}<option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name | escape }} — {{ allocation.price | money }}</option>{% endfor %}</select>{% endif %}
  <label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
  <input class="quantity" id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ selected_variant.quantity_rule.min | default: 1 }}" min="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment | default: 1 }}"{% if selected_variant.quantity_rule.max %} max="{{ selected_variant.quantity_rule.max }}"{% endif %} required>
  <button class="button" type="submit" name="add" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}{{ 'product.add' | t }}{% else %}{{ 'product.unavailable' | t }}{% endif %}</button>
 {% endform %}
 <div class="product-details">
 <details open><summary>{{ 'product.description' | t }}</summary><div class="rte">{{ product.description }}</div></details>
 {% if product.metafields.custom.specifications != blank %}<details><summary>{{ 'product.specifications' | t }}</summary><div class="rte">{{ product.metafields.custom.specifications | metafield_tag }}</div></details>{% endif %}
 {% if product.metafields.custom.care != blank %}<details><summary>{{ 'product.care' | t }}</summary><div class="rte">{{ product.metafields.custom.care | metafield_tag }}</div></details>{% endif %}
 {% if product.metafields.custom.bundle_contents != blank %}<details open><summary>{{ 'product.bundle_contents' | t }}</summary><ul>{% for item in product.metafields.custom.bundle_contents.value %}<li>{{ item | escape }}</li>{% endfor %}</ul></details>{% endif %}
 {% for block in section.blocks %}{% case block.type %}{% when 'text' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% when '@app' %}{% render block %}{% endcase %}{% endfor %}
 </div></div>
</div></div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Продукт",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Покажи производител",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Покажи SKU",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Информация",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Заглавие"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Текст"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Продукт"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
