<div class="section-space" style="--space:{{ section.settings.spacing }}px"><div class="container"><div class="heading-row">{% render 'section-heading', section: section %}{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }} →</a>{% endif %}</div><div class="grid grid-four">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p class="empty-state">{{ 'general.empty_products' | t }}</p>{% endfor %}</div></div></div>
{% schema %}
{
  "name": "Подбрани продукти",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Колекция"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Брой продукти",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Подбрани продукти"
    }
  ]
}
{% endschema %}
