{% assign featured_collection = section.settings.collection | default: collections.all %}
<div class="section-space" style="--space:{{ section.settings.spacing }}px"><div class="container"><div class="heading-row">{% render 'section-heading', section: section %}<a class="text-link" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }} →</a></div><div class="grid grid-four">{% if featured_collection.products.size > 0 %}{% for product in featured_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% elsif section.settings.fallback_catalog == 'bundles' %}{% render 'featured-fallback-card', image_asset: 'kv-bundle-101.jpg', title: 'Starter Kit за Начинаещи', category: 'Комплекти', price: '89.99 лв', compare_price: '129.90 лв', badge: 'Хит' %}{% render 'featured-fallback-card', image_asset: 'kv-bundle-102.jpg', title: 'Deluxe Комплект за Квас', category: 'Комплекти', price: '179.99 лв', compare_price: '249.90 лв', badge: 'Премиум' %}{% render 'featured-fallback-card', image_asset: 'kv-bundle-103.jpg', title: 'Подаръчен Комплект', category: 'Комплекти', price: '129.99 лв', compare_price: '179.90 лв', badge: 'Подарък' %}{% render 'featured-fallback-card', image_asset: 'kv-bundle-104.jpg', title: 'Комплект Първи Хляб', category: 'Комплекти', price: '59.99 лв', compare_price: '84.90 лв', badge: 'За начало' %}{% elsif section.settings.fallback_catalog == 'books' %}{% render 'featured-fallback-card', image_asset: 'kv-book-1.jpg', title: 'Квасен Хляб от А до Я', category: 'Книги', price: '34.99 лв', badge: 'Бестселър' %}{% render 'featured-fallback-card', image_asset: 'kv-book-2.jpg', title: 'Тайните на Ферментацията', category: 'Книги', price: '28.99 лв' %}{% render 'featured-fallback-card', image_asset: 'kv-book-3.jpg', title: 'Whole Grain Baking', category: 'Книги', price: '49.99 лв' %}{% render 'featured-fallback-card', image_asset: 'kv-book-6.jpg', title: 'Пица и Фокача с Квас', category: 'Книги', price: '29.99 лв', badge: 'Ново' %}{% else %}{% render 'featured-fallback-card', image_asset: 'kv-home-product-1.jpg', title: 'Банетон Кошница', category: 'Инструменти', price: '45.99 лв', compare_price: '59.99 лв', badge: 'Хит' %}{% render 'featured-fallback-card', image_asset: 'kv-home-product-2.jpg', title: 'Дигитална Везна', category: 'Измерване', price: '89.99 лв', badge: 'Ново' %}{% render 'featured-fallback-card', image_asset: 'kv-home-product-3.jpg', title: 'Холандска Печка', category: 'Печене', price: '189.99 лв', compare_price: '229.99 лв', badge: 'Топ продукт' %}{% render 'featured-fallback-card', image_asset: 'kv-home-product-4.jpg', title: 'Стартер Кит', category: 'Комплекти', price: '149.99 лв', compare_price: '189.99 лв', badge: 'Промоция' %}{% endif %}</div></div></div>
{% schema %}
{
  "name": "Подбрани продукти",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Колекция"
    },
    {
      "type": "select",
      "id": "fallback_catalog",
      "label": "Вграден каталог",
      "options": [
        { "value": "products", "label": "Продукти" },
        { "value": "bundles", "label": "Комплекти" },
        { "value": "books", "label": "Книги" }
      ],
      "default": "products"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Брой продукти",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Подбрани продукти"
    }
  ]
}
{% endschema %}
