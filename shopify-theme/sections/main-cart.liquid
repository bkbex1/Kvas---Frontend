<div class="container page-space"><h1 class="page-heading">{{ 'cart.title' | t }}</h1>
{% if cart.empty? %}<div class="center empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>{% else %}
<form action="{{ routes.cart_url }}" method="post" id="CartForm"><div class="cart-layout"><div>
{% for item in cart.items %}<article class="cart-item"><a class="cart-item-image" href="{{ item.url }}">{% render 'image', image: item.image, width: 240, sizes: '96px', alt: item.product.title %}</a><div class="cart-item-body"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
{% unless item.product.has_only_default_variant %}<small>{{ item.variant.title | escape }}</small>{% endunless %}
{% if item.selling_plan_allocation %}<small>{{ item.selling_plan_allocation.selling_plan.name | escape }}</small>{% endif %}
{% for property in item.properties %}{% assign initial = property.first | slice: 0 %}{% unless property.last == blank or initial == '_' %}<small>{{ property.first | escape }}: {{ property.last | escape }}</small>{% endunless %}{% endfor %}
{% for discount in item.line_level_discount_allocations %}<p class="discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
<div class="cart-item-controls"><div><label class="visually-hidden" for="Qty-{{ item.index | plus: 1 }}">{{ 'product.quantity' | t }}: {{ item.product.title | escape }}</label><input class="quantity" id="Qty-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} aria-label="{{ 'product.quantity' | t }}: {{ item.product.title | escape }}"></div><div class="price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong></div><a href="{{ item.url_to_remove }}" class="text-link">{{ 'cart.remove' | t }}</a></div></div></article>{% endfor %}
<div class="button-row"><button class="button" name="update" type="submit">{{ 'cart.update' | t }}</button><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>
</div><aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>
{% for discount in cart.cart_level_discount_applications %}<p class="discount">{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>{% endfor %}
<div class="total-row"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="small">{{ 'cart.shipping_note' | t }}</p><label for="CartNote">{{ 'cart.note' | t }}</label><textarea id="CartNote" name="note" rows="3">{{ cart.note | escape }}</textarea><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></aside></div></form>{% endif %}</div>
{% schema %}
{
  "name": "Кошница",
  "tag": "section",
  "class": "kv-section",
  "settings": [],
  "presets": [
    {
      "name": "Кошница"
    }
  ]
}
{% endschema %}
