<div class="section-space white" style="--space:{{ section.settings.spacing }}px"><div class="container narrow center">{% render 'section-heading', section: section %}<div class="rte lead">{{ section.settings.text }}</div>{% render 'newsletter-form', section: section %}<div class="small rte">{{ section.settings.note }}</div></div></div>
{% schema %}
{
  "name": "Бюлетин",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Описание",
      "default": "<p>Рецепти, съвети за пекари и новости директно в пощата ви.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Бележка",
      "default": "<p>Отписване по всяко време.</p>"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Бюлетин"
    }
  ]
}
{% endschema %}
