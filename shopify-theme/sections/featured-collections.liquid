<div class="section-space" style="--space:{{ section.settings.spacing }}px"><div class="container">{% render 'section-heading', section: section, center: true %}<div class="grid grid-two">{% if section.settings.collections.count > 0 %}{% for collection in section.settings.collections %}{% render 'collection-card', collection: collection %}{% endfor %}{% else %}{% for block in section.blocks %}<a class="collection-card" href="{{ block.settings.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% render 'image', image: block.settings.image, fallback_asset: block.settings.fallback_asset, fallback_width: 800, fallback_height: 600, alt: block.settings.heading %}<div class="collection-copy"><p>{{ block.settings.caption | escape }}</p><h3>{{ block.settings.heading | escape }}</h3><span>{{ 'general.view_all' | t }} →</span></div></a>{% endfor %}{% endif %}</div></div></div>
{% schema %}
{
  "name": "Категории",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Колекции",
      "limit": 8
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Категория",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Изображение"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Вградено изображение"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Заглавие"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Подзаглавие"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Връзка"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Категории",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
