<div class="section-space surface" style="--space:{{ section.settings.spacing }}px"><div class="container story-grid"><div class="story-image">{% render 'image', image: section.settings.image, fallback_asset: 'kv-home-story.jpg', fallback_width: 800, fallback_height: 1000, sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.heading %}{% if section.settings.caption != blank %}<div class="story-caption">{{ section.settings.caption | escape }}</div>{% endif %}</div><div>{% render 'section-heading', section: section %}<div class="rte lead">{{ section.settings.text }}</div>{% if section.settings.label != blank %}<a class="button" href="{{ section.settings.url | default: '/pages/about' }}">{{ section.settings.label | escape }} →</a>{% endif %}</div></div></div>
{% schema %}
{
  "name": "История",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Изображение"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "История",
      "default": "<p>Страстта към занаятчийския хляб ни събира около една маса.</p>"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Каре върху снимката"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Бутон",
      "default": "Научете повече за нас"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Връзка"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "История"
    }
  ]
}
{% endschema %}
