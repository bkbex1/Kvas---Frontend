<div class="hero align-{{ section.settings.alignment }}" style="--overlay:{{ section.settings.overlay | divided_by: 100.0 }}">
 <div class="hero-media">{% if section.settings.image %}<picture>{% if section.settings.mobile_image %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">{% endif %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1800,2400', sizes: '100vw' }}</picture>{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div>
 <div class="hero-copy"><div class="hero-copy-inner">{% if section.settings.eyebrow != blank %}<p class="hero-eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h1>{{ section.settings.heading | escape }}{% if section.settings.heading_emphasis != blank %}<strong>{{ section.settings.heading_emphasis | escape }}</strong>{% endif %}</h1><div class="rte">{{ section.settings.text }}</div><div class="button-row">
 {% if section.settings.primary_label != blank %}<a class="button button-white" href="{{ section.settings.primary_url | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}
 {% if section.settings.secondary_label != blank and section.settings.secondary_url != blank %}<a class="button button-outline" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
 </div></div></div></div>
{% schema %}
{
  "name": "Начален hero",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Изображение"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Мобилно изображение"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Втори ред",
      "default": "Перфектен Хляб"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Описание",
      "default": "<p>Оборудване и вдъхновение за квасен хляб — от начинаещи до майстори пекари.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Основен бутон",
      "default": "Разгледайте Магазина"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Основна връзка"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Втори бутон"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Втора връзка"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Потъмняване",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Подравняване",
      "options": [
        {
          "value": "left",
          "label": "Ляво"
        },
        {
          "value": "center",
          "label": "Център"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Начален hero"
    }
  ]
}
{% endschema %}
