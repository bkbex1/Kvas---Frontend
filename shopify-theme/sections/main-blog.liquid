<div class="page-hero">{% render 'image', image: section.settings.image, fallback_asset: 'kv-blog-hero.jpg', fallback_width: 1920, fallback_height: 500, width: 2000, loading: 'eager', alt: blog.title %}<div class="container"><h1>{{ blog.title | escape }}</h1><p>{{ section.settings.subtitle | escape }}</p></div></div>
<div class="container page-space"><nav class="tags" aria-label="{{ 'blog.categories' | t }}"><a href="{{ blog.url }}">{{ 'general.all' | t }}</a>{% for tag in blog.all_tags %}<span>{{ tag | link_to_tag: tag }}</span>{% endfor %}</nav>{% paginate blog.articles by 12 %}<div class="grid grid-three">{% for article in blog.articles %}{% render 'article-card', article: article %}{% else %}{% for block in section.blocks %}<article class="article-card" {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: blog.url }}">{% render 'image', image: block.settings.image, fallback_asset: block.settings.fallback_asset, fallback_width: 1000, fallback_height: 700, alt: block.settings.heading %}</a><div class="card-body"><p class="eyebrow">{{ block.settings.category | escape }}</p><h3>{{ block.settings.heading | escape }}</h3><p class="article-meta">{{ block.settings.meta | escape }}</p><div class="rte">{{ block.settings.text }}</div></div></article>{% endfor %}{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div>
{% schema %}
{
  "name": "Блог",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Изображение"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Описание",
      "default": "Вдъхновение за вашата домашна пекарна"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Статия",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Изображение" },
        { "type": "text", "id": "fallback_asset", "label": "Вградено изображение" },
        { "type": "text", "id": "heading", "label": "Заглавие" },
        { "type": "text", "id": "category", "label": "Категория" },
        { "type": "text", "id": "meta", "label": "Автор и дата" },
        { "type": "richtext", "id": "text", "label": "Резюме" },
        { "type": "url", "id": "url", "label": "Връзка" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Блог"
    }
  ]
}
{% endschema %}
