{% if section.blocks.size > 0 or request.design_mode %}<div class="section-space surface" style="--space:{{ section.settings.spacing }}px"><div class="container">{% render 'section-heading', section: section, center: true %}<div class="faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.text }}</div></details>{% endfor %}</div></div></div>{% endif %}
{% schema %}
{
  "name": "Въпроси и отговори",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "Чести въпроси"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Въпрос",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Въпрос"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Отговор"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Въпроси и отговори"
    }
  ]
}
{% endschema %}
