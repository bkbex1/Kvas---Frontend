{% if section.blocks.size > 0 or request.design_mode %}<div class="section-space" style="--space:{{ section.settings.spacing }}px"><div class="container">{% render 'section-heading', section: section, center: true %}<div class="grid grid-three">{% for block in section.blocks %}<article class="content-card" {{ block.shopify_attributes }}>{% if block.settings.image %}{% render 'image', image: block.settings.image, sizes: '(min-width: 750px) 33vw, 100vw' %}{% endif %}{% if block.settings.video %}{{ block.settings.video | video_tag: controls: true, preload: 'none', image_size: '900x' }}{% endif %}<div class="card-body"><h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.url != blank %}<a class="text-link" href="{{ block.settings.url }}">{{ block.settings.label | default: block.settings.heading | escape }} →</a>{% endif %}</div></article>{% endfor %}</div></div></div>{% endif %}
{% schema %}
{
  "name": "Съдържание и екип",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Карта",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Изображение"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify видео"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Заглавие"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Текст"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Връзка – текст"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Връзка"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Съдържание и екип"
    }
  ]
}
{% endschema %}
