{% if section.blocks.size > 0 or request.design_mode %}<div class="section-space surface" style="--space:{{ section.settings.spacing }}px"><div class="container">{% render 'section-heading', section: section %}<div class="grid grid-three">{% for block in section.blocks %}<figure class="testimonial" {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{% if block.settings.image %}{% render 'image', image: block.settings.image, width: 120, sizes: '48px', alt: block.settings.author %}{% endif %}<div><strong>{{ block.settings.author | escape }}</strong><p>{{ block.settings.role | escape }}</p></div></figcaption></figure>{% else %}<p>{{ 'general.editor_reviews' | t }}</p>{% endfor %}</div></div></div>{% endif %}
{% schema %}
{
  "name": "Отзиви",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Реален отзив",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Текст (само реален отзив)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Автор"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Описание"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Изображение"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Отзиви"
    }
  ]
}
{% endschema %}
