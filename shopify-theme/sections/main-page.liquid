<div class="container narrow page-space">{% if section.settings.show_title %}<h1 class="page-heading">{{ page.title | escape }}</h1>{% endif %}<div class="rte">{{ page.content }}</div></div>
{% schema %}
{
  "name": "Страница",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Покажи заглавие",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Страница"
    }
  ]
}
{% endschema %}
