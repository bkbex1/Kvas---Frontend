<div class="section-space" style="--space:{{ section.settings.spacing }}px"><div class="container story-grid"><div>{% render 'section-heading', section: section %}<div class="rte lead">{{ section.settings.text }}</div></div><div class="mosaic">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render 'image', image: block.settings.image, width: 700, sizes: '(min-width: 750px) 25vw, 50vw' %}</div>{% endfor %}</div></div></div>
{% schema %}
{
  "name": "История и снимки",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "История"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Разстояние",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Снимка",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Изображение"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "История и снимки"
    }
  ]
}
{% endschema %}
