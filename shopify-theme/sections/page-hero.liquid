<div class="page-hero">{% if section.settings.image %}{% render 'image', image: section.settings.image, width: 2000, loading: 'eager' %}{% endif %}<div class="container {% if section.settings.center %}center{% endif %}"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | default: page.title | escape }}</h1><div class="rte">{{ section.settings.text }}</div></div></div>
{% schema %}
{
  "name": "Заглавие със снимка",
  "tag": "section",
  "class": "kv-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Изображение"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Надзаглавие"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Текст"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Центрирано",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Заглавие със снимка"
    }
  ]
}
{% endschema %}
